OPENAI_API_KEY=your-openai-api-key
LANGSMITH_API_KEY=your-langsmith-api-key
# LangSmith tracing project name; the publisher attaches both judges here.
LANGSMITH_PROJECT=your-tracing-project-name
# Optional: set only if your LangSmith workspace requires explicit tenant routing.
# LANGSMITH_TENANT_ID=your-langsmith-tenant-or-workspace-id
# Optional: select a saved LangSmith playground model configuration for native LLM evaluators.
# LANGSMITH_EVALUATOR_PLAYGROUND_SETTINGS_ID=your-playground-settings-id
